# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.venv/
venv/

# uv
.uv/

# Generated data and run outputs. The cache is derived from a seed and is rebuilt in about a


# minute; run outputs are regenerated by `pinnbp experiment`. Neither belongs in history.
data/cache/
reports/*/best.pt
reports/**/*.npz

# Real datasets are large and separately licensed -- see docs/DATA.md
data/raw/
data/ppgbp/
data/uci/
*.mat

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Secrets -- nothing here should ever need one, which is the point of listing them
.env
.env.local
*.key
*.pem

# Smoke-run outputs: the quick config exists to prove the pipeline runs, and its numbers are
# deliberately meaningless (8 test subjects). Committing them would invite misreading.
reports/smoke-*/
